# Clés Gemini — séparées par des virgules (1 à 4+ projets Google AI Studio)
# Exemple : GEMINI_API_KEYS=cle_projet_1,cle_projet_2,cle_projet_3,cle_projet_4
GEMINI_API_KEYS=

# Modèle chat (optionnel, défaut: gemini-3.6-flash)
# GEMINI_CHAT_MODEL=gemini-3.6-flash

# URL du site govern-landing (liens cliquables dans le chat /test)
NEXT_PUBLIC_LANDING_URL=https://www.govern-one.com

# CORS — origine principale du landing en production
FRONTEND_URL=https://www.govern-one.com

# CORS — origines supplémentaires (previews Vercel du landing, séparées par des virgules)
# FRONTEND_URLS=https://govern-landing-git-main-votre-org.vercel.app

# ── RAG Supabase (recommandé en prod) ──────────────────────────
# Même projet Supabase que Portfolio possible (table govern_document_chunks).
# L'ingest se fait en LOCAL (npm run ingest), pas sur Vercel.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Vercel : copier ces variables dans Project Settings → Environment Variables
# Voir docs/DEPLOY_VERCEL.md pour le guide complet.
